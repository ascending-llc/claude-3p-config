# Keep comments and unrelated profiles intact.
[sso-session ccwb]
sso_start_url = https://example.awsapps.com/start
sso_region = us-east-2
sso_registration_scopes = sso:account:access

[profile "my profile#team;dev"]  ; unrelated [notes]
region = eu-west-1
output = json

[profile CCWB]
sso_session = ccwb
sso_account_id = 123456789012
sso_role_name = ClaudeBedrockUser
region = us-east-1

[profile work] ; deployment
region = eu-central-1

[services "team]dev"] ; keep ] in this comment
s3 =
  endpoint_url = https://example.com
