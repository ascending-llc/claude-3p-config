# Keep this comment and spacing.
[default]
region = eu-west-1

[profile work]
  region = eu-west-2

# Claude Code and Codex on Amazon Bedrock (CCWB profile). Add to ~/.aws/config (Windows: %USERPROFILE%\.aws\config).

[sso-session ccwb]
sso_start_url = https://example.awsapps.com/start
sso_region = us-east-2
sso_registration_scopes = sso:account:access

[profile CCWB]
sso_session = ccwb
sso_account_id = 123456789012
sso_role_name = ClaudeBedrockUser
region = us-east-1
