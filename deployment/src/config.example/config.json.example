{
  "profiles": {
    "ASCENDING-CCWB": {
      "auth_type": "idc",
      "sso_enabled": false,
      "aws_region": "REPLACE_WITH_BEDROCK_REGION",
      "idc_region": "REPLACE_WITH_IDC_REGION",
      "idc_start_url": "REPLACE_WITH_IDC_START_URL",
      "idc_account_id": "REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID",
      "idc_permission_set_name": "REPLACE_WITH_PERMISSION_SET_NAME"
    }
  },
  "desktop": {
    "models": [
      {
        "name": "REPLACE_WITH_SONNET_AIP_ARN",
        "labelOverride": "Sonnet",
        "anthropicFamilyTier": "sonnet"
      },
      {
        "name": "REPLACE_WITH_HAIKU_AIP_ARN",
        "labelOverride": "Haiku",
        "anthropicFamilyTier": "haiku"
      }
    ],
    "mobileconfig": {
      "profile_identifier": "com.example.ascending.claude.ccwb",
      "profile_uuid": "00000000-0000-4000-8000-000000000001",
      "profile_display_name": "Claude Desktop Bedrock example",
      "payload_identifier": "com.example.ascending.claude.ccwb.payload",
      "payload_uuid": "00000000-0000-4000-8000-000000000002",
      "payload_display_name": "Claude Desktop Bedrock example"
    },
    "mcp_servers": [
      {
        "name": "example-registry",
        "transport": "http",
        "url": "REPLACE_WITH_REMOTE_MCP_URL"
      }
    ]
  }
}
